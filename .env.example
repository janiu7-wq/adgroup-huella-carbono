# Microsoft SharePoint & Azure Entra ID (Para almacenamiento de evidencias y respaldos de auditoria)
# Configura estas variables en tu proyecto de Vercel (Project Settings -> Environment Variables)
AZURE_TENANT_ID="tu-tenant-id-de-microsoft-365"
AZURE_CLIENT_ID="tu-client-id-de-azure-app"
AZURE_CLIENT_SECRET="tu-client-secret"
SHAREPOINT_SITE_ID="tu-sitio-sharepoint-id"
